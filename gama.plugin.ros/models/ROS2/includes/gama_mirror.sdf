<?xml version="1.0" ?>
<!--
  A world whose only job is to show what GAMA is simulating.

  Six entities, each driven by gz-sim's VelocityControl on /model/gama_<n>/cmd_vel. Gravity and
  friction are off: the entities do exactly what GAMA tells them, so the 3D view is a rendering of the
  GAMA simulation rather than a second simulation that could disagree with it.

  Run with:
      gz sim -r gama_mirror.sdf
-->
<sdf version="1.9">
  <world name="gama_mirror">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="gama_0">
      <pose>-3.0 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.35 0.55 0.85 1</ambient>
            <diffuse>0.35 0.55 0.85 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_0/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>
    <model name="gama_1">
      <pose>-1.5 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.85 0.35 0.35 1</ambient>
            <diffuse>0.85 0.35 0.35 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_1/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>
    <model name="gama_2">
      <pose>0.0 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.35 0.75 0.45 1</ambient>
            <diffuse>0.35 0.75 0.45 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_2/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>
    <model name="gama_3">
      <pose>1.5 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.90 0.65 0.20 1</ambient>
            <diffuse>0.90 0.65 0.20 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_3/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>
    <model name="gama_4">
      <pose>3.0 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.60 0.40 0.80 1</ambient>
            <diffuse>0.60 0.40 0.80 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_4/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>
    <model name="gama_5">
      <pose>4.5 0.0 0.25 0 0 0</pose>
      <link name="body">
        <!-- No gravity: these entities are markers driven by GAMA, not physical objects -->
        <gravity>false</gravity>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.6 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.25 0.70 0.75 1</ambient>
            <diffuse>0.25 0.70 0.75 1</diffuse>
          </material>
        </visual>
        <!-- A nose, so that the heading GAMA sends is readable in the 3D view -->
        <visual name="nose_visual">
          <pose>0.35 0 0 0 0 0</pose>
          <geometry><box><size>0.15 0.12 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- Subscribes to /model/gama_5/cmd_vel (gz.msgs.Twist) and applies it as the model's own
           velocity, in its body frame. No wheels, no friction: whatever GAMA sends is what happens,
           which is what makes this a mirror rather than a simulation of its own. -->
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl">
      </plugin>
    </model>

  </world>
</sdf>
